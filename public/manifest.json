{
  "name": "Семейное приложение",
  "short_name": "Семейное",
  "description": "Приложение для семейного использования",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#007bff",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "orientation": "portrait",
  "categories": ["lifestyle", "family"],
  "prefer_related_applications": false,
  "related_applications": [],
  "screenshots": [
    {
      "src": "/screenshot1.png",
      "sizes": "1280x720",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "Баланс",
      "short_name": "Баланс",
      "description": "Проверить текущий баланс",
      "url": "/?tab=balance",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Геолокация",
      "short_name": "Геолокация",
      "description": "Отслеживание местоположения",
      "url": "/?tab=location",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "background_color": "#ffffff",
  "permissions": [
    "geolocation",
    "notifications",
    "background",
    "wakelock",
    "persistent-storage"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}